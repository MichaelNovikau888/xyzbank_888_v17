<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        Рефакторинг: phone_number BIGINT → VARCHAR(20).
        Причина: телефонный номер — не число (может начинаться с +7, содержать пробелы),
                 хранение в BIGINT некорректно семантически.
    -->
    <changeSet id="007-phone-number-to-varchar" author="xyz-bank">
        <modifyDataType tableName="profile"
                        schemaName="profile"
                        columnName="phone_number"
                        newDataType="VARCHAR(20)"/>
    </changeSet>

</databaseChangeLog>
