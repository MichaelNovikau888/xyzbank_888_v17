<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-registration" author="xyz-bank">
        <createTable tableName="registration" schemaName="profile">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="country" type="VARCHAR(166)"><constraints nullable="false"/></column>
            <column name="city" type="VARCHAR(160)"/>
            <column name="index" type="BIGINT"><constraints nullable="false"/></column>
            <column name="region" type="VARCHAR(160)"/>
            <column name="district" type="VARCHAR(160)"/>
            <column name="locality" type="VARCHAR(160)"/>
            <column name="street" type="VARCHAR(160)"/>
            <column name="house_number" type="VARCHAR(20)"/>
            <column name="house_block" type="VARCHAR(20)"/>
            <column name="flat_number" type="VARCHAR(40)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-actual-registration" author="xyz-bank">
        <createTable tableName="actual_registration" schemaName="profile">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="country" type="VARCHAR(166)"><constraints nullable="false"/></column>
            <column name="city" type="VARCHAR(160)"/>
            <column name="index" type="BIGINT"><constraints nullable="false"/></column>
            <column name="region" type="VARCHAR(160)"/>
            <column name="district" type="VARCHAR(160)"/>
            <column name="locality" type="VARCHAR(160)"/>
            <column name="street" type="VARCHAR(160)"/>
            <column name="house_number" type="VARCHAR(20)"/>
            <column name="house_block" type="VARCHAR(20)"/>
            <column name="flat_number" type="VARCHAR(40)"/>
        </createTable>
    </changeSet>

    <changeSet id="003-create-passport" author="xyz-bank">
        <createTable tableName="passport" schemaName="profile">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="series" type="BIGINT"/>
            <column name="number" type="BIGINT"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="middle_name" type="VARCHAR(255)"/>
            <column name="gender" type="VARCHAR(10)"/>
            <column name="birth_date" type="DATE"/>
            <column name="birth_place" type="VARCHAR(255)"/>
            <column name="issued_by" type="VARCHAR(255)"/>
            <column name="date_of_issue" type="DATE"/>
            <column name="division_code" type="INTEGER"/>
            <column name="expiration_date" type="DATE"/>
            <column name="registration_id" type="BIGINT">
                <constraints foreignKeyName="fk_passport_registration"
                             references="profile.registration(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-create-profile" author="xyz-bank">
        <createTable tableName="profile" schemaName="profile">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="phone_number" type="BIGINT"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="name_on_card" type="VARCHAR(255)"/>
            <!-- СНИЛС — страховой номер индивидуального лицевого счёта -->
            <column name="snils" type="BIGINT"/>
            <!-- ИНН — идентификационный номер налогоплательщика -->
            <column name="inn" type="BIGINT"/>
            <column name="passport_id" type="BIGINT">
                <constraints foreignKeyName="fk_profile_passport"
                             references="profile.passport(id)"/>
            </column>
            <column name="actual_registration_id" type="BIGINT">
                <constraints foreignKeyName="fk_profile_actual_registration"
                             references="profile.actual_registration(id)"/>
            </column>
        </createTable>
        <createIndex tableName="profile" schemaName="profile" indexName="idx_profile_email" unique="true">
            <column name="email"/>
        </createIndex>
        <createIndex tableName="profile" schemaName="profile" indexName="idx_profile_snils" unique="true">
            <column name="snils"/>
        </createIndex>
        <createIndex tableName="profile" schemaName="profile" indexName="idx_profile_inn" unique="true">
            <column name="inn"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-account-details" author="xyz-bank">
        <createTable tableName="account_details_id" schemaName="profile">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="profile_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_account_details_profile"
                             references="profile.profile(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-create-audit" author="xyz-bank">
        <createTable tableName="audit" schemaName="profile">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true" nullable="false"/></column>
            <column name="entity_type" type="VARCHAR(40)"><constraints nullable="false"/></column>
            <column name="operation_type" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="created_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="modified_at" type="TIMESTAMP"/>
            <column name="new_entity_json" type="TEXT"/>
            <column name="entity_json" type="TEXT"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

</databaseChangeLog>
